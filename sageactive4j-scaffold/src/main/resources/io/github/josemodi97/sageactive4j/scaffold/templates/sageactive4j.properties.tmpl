# Generated by {{generator}} for {{artifact}}; loaded by SageController.
# Secrets come from environment variables, so this file is safe to commit.
sageactive4j.region=FR
sageactive4j.subscription-key=${SAGEACTIVE4J_SUBSCRIPTION_KEY:}
sageactive4j.organization-id=${SAGEACTIVE4J_ORGANIZATION_ID:}
sageactive4j.client-id=${SAGEACTIVE4J_CLIENT_ID:}
sageactive4j.client-secret=${SAGEACTIVE4J_CLIENT_SECRET:}

# Browser sign-in: open /sage/oauth/login once to connect a Sage account.
# Register the redirect URI for your app in the Sage Developer Center, and
# protect the login path: whoever signs in sets the credentials this app uses.
sageactive4j.oauth.enabled=true
sageactive4j.oauth.redirect-uri=http://localhost:8080/sage/oauth/callback

# Keeps the tokens across restarts. For several instances, define your own
# TokenStore bean (JDBC, Redis, ...) instead.
sageactive4j.token-store.file=${user.home}/.sageactive4j/spring-tokens.properties
