import io.github.josemodi97.sageactive4j.SageActive4jClient;
import io.github.josemodi97.sageactive4j.graphql.ListOptions;
import io.github.josemodi97.sageactive4j.model.Customer;
import io.github.josemodi97.sageactive4j.model.UserProfile;

public class SageActiveExample {

    public static void main(String[] args) {
        try (SageActive4jClient sage = SageActive4jClient.fromEnvironment()) {
            UserProfile me = sage.users().getProfile();
            System.out.println("Signed in as " + me.getFullName() + " <" + me.getAuthenticationEmail() + ">");

            System.out.println("Customers:");
            for (Customer customer : sage.thirdParties().customers(ListOptions.first(20))) {
                System.out.println("  " + customer.getCode() + "  " + customer.getSocialName());
            }
        }
    }
}
