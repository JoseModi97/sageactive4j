import io.github.josemodi97.sageactive4j.SageActive4jClient;
import io.github.josemodi97.sageactive4j.model.UserProfile;
import io.github.josemodi97.sageactive4j.{{adapterPackage}}.SageOAuthCallbackHandler;
import io.github.josemodi97.sageactive4j.{{adapterPackage}}.SageOAuthFlow;
import java.io.IOException;
import {{servletPackage}}.annotation.WebServlet;
import {{servletPackage}}.http.HttpServlet;
import {{servletPackage}}.http.HttpServletRequest;
import {{servletPackage}}.http.HttpServletResponse;

@WebServlet("/sage/*")
public class SageActiveServlet extends HttpServlet {

    private SageActive4jClient sage;
    private SageOAuthFlow flow;
    private SageOAuthCallbackHandler callback;

    @Override
    public void init() {
        sage = SageActive4jClient.fromEnvironment();
        flow = new SageOAuthFlow(sage.auth(), sage.getConfig().getRedirectUri());
        callback = new SageOAuthCallbackHandler(flow,
                (request, response, token) -> response.sendRedirect(request.getContextPath() + "/sage/me"),
                (request, response, failure) -> log("Sage Active sign-in failed: " + failure.getReason(), failure));
    }

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws IOException {
        String path = request.getPathInfo() == null ? "" : request.getPathInfo();
        switch (path) {
            case "/login":
                flow.redirect(request, response);
                break;
            case "/callback":
                callback.handle(request, response);
                break;
            case "/me":
                UserProfile me = sage.users().getProfile();
                response.setContentType("text/plain;charset=UTF-8");
                response.getWriter().println("Signed in to Sage Active as " + me.getFullName());
                break;
            default:
                response.sendError(HttpServletResponse.SC_NOT_FOUND);
        }
    }

    @Override
    public void destroy() {
        sage.close();
    }
}
