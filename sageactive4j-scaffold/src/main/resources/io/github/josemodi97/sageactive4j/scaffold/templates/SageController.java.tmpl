package sageactive4j;

// Generated by {{generator}}. Move this into your application's package,
// under your @SpringBootApplication class, so component scanning finds it.
// Requires {{artifact}}, which provides the SageActive4jClient bean.
//
// Settings are in sageactive4j.properties, loaded by the @PropertySource
// below. To keep them in application.properties instead, move them there and
// delete that line.
//
//   GET  /sage/accounting/accounts  the first 50 accounts of the chart
//   POST /sage/sales/invoice        creates, numbers and posts a one-line
//                                   invoice: customerId, productId,
//                                   unitPrice, quantity (default 1)
//
// Posting an invoice is a real accounting write: try it on a sandbox
// organization first, and protect this endpoint before deploying.

import io.github.josemodi97.sageactive4j.SageActive4jClient;
import io.github.josemodi97.sageactive4j.graphql.ListOptions;
import io.github.josemodi97.sageactive4j.input.SalesInvoiceInput;
import io.github.josemodi97.sageactive4j.input.SalesInvoiceLineInput;
import io.github.josemodi97.sageactive4j.model.AccountingAccount;
import io.github.josemodi97.sageactive4j.model.InvoicePosting;
import java.math.BigDecimal;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import org.springframework.context.annotation.PropertySource;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/sage")
@PropertySource("classpath:sageactive4j.properties")
public class SageController {

    private final SageActive4jClient sage;

    public SageController(SageActive4jClient sage) {
        this.sage = sage;
    }

    @GetMapping("/accounting/accounts")
    public List<Map<String, String>> accounts() {
        List<Map<String, String>> accounts = new ArrayList<>();
        for (AccountingAccount account : sage.accounting().accounts(ListOptions.first(50))) {
            Map<String, String> row = new LinkedHashMap<>();
            row.put("code", account.getCode());
            row.put("name", account.getName());
            accounts.add(row);
        }
        return accounts;
    }

    @PostMapping("/sales/invoice")
    public Map<String, String> createInvoice(@RequestParam("customerId") String customerId,
                                             @RequestParam("productId") String productId,
                                             @RequestParam("unitPrice") BigDecimal unitPrice,
                                             @RequestParam(name = "quantity", defaultValue = "1") BigDecimal quantity) {
        InvoicePosting posted = sage.sales().createAndPostInvoice(new SalesInvoiceInput()
                .customerId(customerId)
                .documentDate(LocalDate.now())
                .addLine(new SalesInvoiceLineInput()
                        .productId(productId)
                        .totalQuantity(quantity)
                        .unitPrice(unitPrice)));

        Map<String, String> result = new LinkedHashMap<>();
        result.put("invoiceId", posted.getInvoiceId());
        result.put("number", posted.getOperationalNumber());
        return result;
    }
}
